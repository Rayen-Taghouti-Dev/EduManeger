# =============================================================================
# EduManager Pro — Environment Variables
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=EduManager Pro
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PREFIX=api/v1

# -----------------------------------------------------------------------------
# Frontend (apps/web) — set on Vercel (build-time for NEXT_PUBLIC_*)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=EduManager Pro
# Must include the /api/v1 prefix. Production example:
# NEXT_PUBLIC_API_URL=https://edumanager-api.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# -----------------------------------------------------------------------------
# Backend (apps/api) — set on Render
# -----------------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated list allowed. Production: your Vercel URL(s).
CORS_ORIGIN=http://localhost:3000
# Set false only for local debugging of a pre-built image.
RUN_MIGRATIONS=true

# -----------------------------------------------------------------------------
# Database (PostgreSQL / Neon)
# -----------------------------------------------------------------------------
# Local:
DATABASE_URL=postgresql://edumanager:edumanager_secret@localhost:5432/edumanager_pro?schema=public
DIRECT_URL=postgresql://edumanager:edumanager_secret@localhost:5432/edumanager_pro?schema=public
# Neon production:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
POSTGRES_USER=edumanager
POSTGRES_PASSWORD=edumanager_secret
POSTGRES_DB=edumanager_pro
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Authentication (JWT)
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-to-a-strong-random-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-to-another-strong-random-secret-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
AUTH_REFRESH_COOKIE_NAME=edumanager_refresh_token
# Local defaults. Production defaults (when unset): Secure=true, SameSite=none
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# Production (Vercel ↔ Render cross-site):
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAME_SITE=none
AUTH_SEED_PASSWORD=ChangeMe123!

# -----------------------------------------------------------------------------
# Redis (Cache & Pub/Sub) — planned, not required for current MVP
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# MinIO (Object Storage — S3 Compatible) — planned, not required for current MVP
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=edumanager_minio
MINIO_SECRET_KEY=edumanager_minio_secret
MINIO_BUCKET=edumanager-uploads
MINIO_USE_SSL=false

# -----------------------------------------------------------------------------
# Email (SMTP — for notifications & invitations)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=EduManager Pro
SMTP_FROM_EMAIL=noreply@edumanager.pro

# -----------------------------------------------------------------------------
# AI (Google Gemini Flash Lite)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# -----------------------------------------------------------------------------
# PDF Generation
# -----------------------------------------------------------------------------
PDF_COMPANY_NAME=EduManager Pro
PDF_COMPANY_ADDRESS=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# -----------------------------------------------------------------------------
# File Upload
# -----------------------------------------------------------------------------
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# -----------------------------------------------------------------------------
# Docker / Render
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=edumanager-pro
